# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hh
DB_PASSWORD=hh_dev_password
DB_DATABASE=hh_game_market

# Supplier stubs run inside this same app; the worker still calls them over HTTP.
SUPPLIER_A_URL=http://localhost:3000/api/stubs/suppliers/a
SUPPLIER_B_URL=http://localhost:3000/api/stubs/suppliers/b
SUPPLIERS=a,b
SUPPLIER_TIMEOUT_MS=3000
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_RETRY_BASE_MS=500
# Fresh request_ids to try per supplier after it answered with a code we had
# to reject (already delivered to somebody else, or not in its book).
SUPPLIER_MAX_ROUNDS=3
# How often every supplier's book (GET /issued) is compared with our deliveries.
SUPPLIER_AUDIT_INTERVAL_MS=60000
# Requests we allow ourselves per supplier in any SUPPLIER_RATE_WINDOW_MS window
# (issue + book lookups), across every app instance. 0 = unlimited.
# Per-supplier override: SUPPLIER_A_RATE_LIMIT / SUPPLIER_B_RATE_LIMIT.
SUPPLIER_RATE_LIMIT=60
SUPPLIER_RATE_WINDOW_MS=60000
DELIVERY_POLL_INTERVAL_MS=2000
DELIVERY_CONCURRENCY=4

# Payment provider stub: refunds for items that could not be issued go here.
PSP_URL=http://localhost:3000/api/stubs/payments
PSP_TIMEOUT_MS=3000

# Fault injection for the stubs (0..1). Also adjustable at runtime:
#   PUT /api/stubs/suppliers/a/config {"errorRate":0.5,"timeoutRate":0.2,"unavailableSkus":["KEY-EFT"],
#                                      "duplicateRate":0.3,"foreignRate":0.3,"errorAfterIssueRate":0.3}
#   PUT /api/stubs/payments/config    {"errorRate":1}
STUB_A_ERROR_RATE=0
STUB_A_TIMEOUT_RATE=0
STUB_B_ERROR_RATE=0
STUB_B_TIMEOUT_RATE=0
STUB_HANG_MS=10000
STUB_PSP_ERROR_RATE=0
# What the stub suppliers accept per STUB_RATE_WINDOW_MS; beyond that: 429.
STUB_A_RATE_LIMIT=60
STUB_B_RATE_LIMIT=60
STUB_RATE_WINDOW_MS=60000

# json = one JSON object per line; anything else = classic coloured output.
LOG_FORMAT=json

# Recovery sweep: re-queues orders stuck in `delivering` (worker crashed mid-flight)
# and retries parked ones (out_of_stock / delivery_failed) after a cooldown.
RECOVERY_INTERVAL_MS=30000
DELIVERY_STALE_AFTER_MS=60000
RECOVERY_RETRY_AFTER_MS=60000
